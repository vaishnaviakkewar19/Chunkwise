      "seed": 1576881,
      "version": 1,
      "versionNonce": 1584800,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763100000000,
      "link": null,
      "locked": false,
      "text": "Design decisions:  spans, not copied strings (offsets drive the visualiser and the hit test)  ·  sizes in characters, not tokens  ·  code fences and tables are atomic for the Markdown chunker\nenrichment changes only the embedded text, never offsets  ·  parent-child scores the parent span (what the LLM would see)  ·  hashing embedder keeps the demo offline and deterministic\neverything in memory: no database, the whole corpus indexes in milliseconds  ·  questions embedded once per run and reused across strategies",
      "originalText": "Design decisions:  spans, not copied strings (offsets drive the visualiser and the hit test)  ·  sizes in characters, not tokens  ·  code fences and tables are atomic for the Markdown chunker\nenrichment changes only the embedded text, never offsets  ·  parent-child scores the parent span (what the LLM would see)  ·  hashing embedder keeps the demo offline and deterministic\neverything in memory: no database, the whole corpus indexes in milliseconds  ·  questions embedded once per run and reused across strategies",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "decisions",
      "lineHeight": 1.25,
