{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Chunkwise": {
    "Embedder": {
      "Provider": "hashing",
      "OllamaUrl": "http://localhost:11434",
      "OllamaModel": "nomic-embed-text",
      "CacheDirectory": ".chunkwise-cache"
    }
  }
}
